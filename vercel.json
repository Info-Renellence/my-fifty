{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/act.js": { "maxDuration": 60 },
    "api/cron.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/((?!api/|icons/|.*\\..*).*)", "destination": "/" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] },
    { "source": "/(app.js|lib.js|app.css|index.html|staging.js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=()" }
    ] }
  ]
}
